<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Fades the preview while the camera switches. -->
    <View
        android:id="@+id/curtain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no" />

    <com.darshan.horizoncam.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Viewfinder. Tap to focus, swipe sideways to change mode." />

    <!-- Scrims keep chrome legible over a bright viewfinder (sized in code). -->
    <View
        android:id="@+id/scrimTop"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/scrimBottom"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:importantForAccessibility="no" />

    <!-- Top bar: horizon lock on the left, status in the middle, video size on the right. -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnSteady"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stabilization"
            android:scaleType="center" />

        <TextView
            android:id="@+id/recTime"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_rec"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="sans-serif-medium"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipRes"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_chip_outline"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="FHD 30"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- Drop-down menus; they grow out of their buttons. -->
    <LinearLayout
        android:id="@+id/steadyMenu"
        android:layout_width="312dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_menu"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/resMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_menu"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="11dp"
        android:visibility="gone" />

    <!-- One-time tip about horizon lock (closes on tap). -->
    <TextView
        android:id="@+id/tipBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bg_tip"
        android:elevation="6dp"
        android:maxWidth="300dp"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Bottom: quick controls, zoom, modes, shutter row. -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <com.darshan.horizoncam.ui.QuickPanel
            android:id="@+id/quickPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/zoomArea"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/btnFrame"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_round_glass"
                android:contentDescription="Recording frame"
                android:scaleType="center"
                android:src="@drawable/ic_orientation_auto"
                android:tint="@android:color/white" />

            <com.darshan.horizoncam.ui.ZoomBar
                android:id="@+id/zoomRow"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_capsule"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />

            <ImageButton
                android:id="@+id/btnQuick"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_round_glass"
                android:contentDescription="Quick controls"
                android:scaleType="center"
                android:src="@drawable/ic_quick_controls"
                android:tint="@android:color/white" />
        </FrameLayout>

        <!-- Mode carousel: the selected mode stays centred over the shutter. -->
        <FrameLayout
            android:id="@+id/modeStrip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <com.darshan.horizoncam.ui.ModeCarousel
                android:id="@+id/modeRow"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/modePhoto"
                    style="@style/ModeText"
                    android:text="PHOTO" />

                <TextView
                    android:id="@+id/modeVideo"
                    style="@style/ModeText"
                    android:text="VIDEO" />

                <TextView
                    android:id="@+id/modeTimelapse"
                    style="@style/ModeText"
                    android:text="HYPERLAPSE" />
            </com.darshan.horizoncam.ui.ModeCarousel>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="104dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_thumb"
                android:clickable="true"
                android:contentDescription="Open last capture in gallery"
                android:focusable="true"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_library" />

            <ImageButton
                android:id="@+id/btnPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_round_glass"
                android:contentDescription="Pause recording"
                android:scaleType="center"
                android:src="@drawable/ic_pause"
                android:tint="@android:color/white"
                android:visibility="gone" />

            <com.darshan.horizoncam.ui.ShutterButton
                android:id="@+id/shutter"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center" />

            <ImageButton
                android:id="@+id/btnSwitch"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_round_glass"
                android:contentDescription="Switch to front camera"
                android:scaleType="center"
                android:src="@drawable/ic_flip_camera_android"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnSnap"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_round_glass"
                android:contentDescription="Take a photo while recording"
                android:scaleType="center"
                android:src="@drawable/ic_photo_camera"
                android:tint="@android:color/white"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_toast"
        android:elevation="6dp"
        android:gravity="center"
        android:minHeight="44dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/permissionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/permission_title"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/permissionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/permission_needed"
            android:textColor="#FFA1A1A8"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnGrant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_accent"
            android:fontFamily="sans-serif-medium"
            android:minWidth="160dp"
            android:minHeight="48dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:stateListAnimator="@null"
            android:text="@string/grant"
            android:textAllCaps="false"
            android:textColor="#FF000000"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>

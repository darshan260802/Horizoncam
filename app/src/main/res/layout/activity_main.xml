<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.darshan.horizoncam.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top controls -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/TopIcon"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/chipLock"
            style="@style/Chip"
            android:drawableStart="@drawable/ic_360"
            android:text="360°" />

        <TextView
            android:id="@+id/chipFrame"
            style="@style/Chip"
            android:drawableStart="@drawable/ic_orientation_auto"
            android:text="AUTO" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnTorch"
            style="@style/TopIcon"
            android:contentDescription="Torch"
            android:src="@drawable/ic_flashlight_off" />

        <ImageButton
            android:id="@+id/btnTimer"
            style="@style/TopIcon"
            android:contentDescription="Self timer"
            android:src="@drawable/ic_timer_off" />

        <ImageButton
            android:id="@+id/btnEv"
            style="@style/TopIcon"
            android:contentDescription="Exposure and white balance"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <!-- Status line -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/recTime"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rec"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/evPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_toast"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/evLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exposure 0.0"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/evSeek"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <LinearLayout
                android:id="@+id/wbRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zoomRow"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <LinearLayout
            android:id="@+id/modeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modePhoto"
                style="@style/ModeText"
                android:text="PHOTO" />

            <TextView
                android:id="@+id/modeVideo"
                style="@style/ModeText"
                android:text="VIDEO" />

            <TextView
                android:id="@+id/modeTimelapse"
                style="@style/ModeText"
                android:text="TIMELAPSE" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="36dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="Open last capture"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_library" />

            <com.darshan.horizoncam.ui.ShutterButton
                android:id="@+id/shutter"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="center" />

            <ImageButton
                android:id="@+id/btnSwitch"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="36dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="Switch camera"
                android:scaleType="center"
                android:src="@drawable/ic_cameraswitch"
                android:tint="@android:color/white" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_toast"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_needed"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnGrant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/grant" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fades the preview while the camera switches, so changes feel smooth. -->
    <View
        android:id="@+id/curtain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1"
        android:background="@android:color/black" />

    <com.darshan.horizoncam.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Status only at the top: nothing up here needs to be tapped. -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/recTime"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rec"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Everything you touch lives in the bottom third (one-handed use). -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/popupHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/optionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/optionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_dim"
                    android:textSize="12.5sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/optionRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/evPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/evLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exposure 0.0"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/evSeek"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/wbRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/quickBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qSettings"
                style="@style/QuickItem"
                android:contentDescription="Settings"
                android:drawableTop="@drawable/ic_settings"
                android:text="More" />

            <TextView
                android:id="@+id/qLock"
                style="@style/QuickItem"
                android:contentDescription="Horizon lock mode"
                android:drawableTop="@drawable/ic_360"
                android:text="360°" />

            <TextView
                android:id="@+id/qFrame"
                style="@style/QuickItem"
                android:contentDescription="Frame orientation"
                android:drawableTop="@drawable/ic_orientation_auto"
                android:text="Auto" />

            <TextView
                android:id="@+id/qTorch"
                style="@style/QuickItem"
                android:contentDescription="Torch"
                android:drawableTop="@drawable/ic_flashlight_off"
                android:text="Light" />

            <TextView
                android:id="@+id/qTimer"
                style="@style/QuickItem"
                android:contentDescription="Self timer"
                android:drawableTop="@drawable/ic_timer_off"
                android:text="Timer" />

            <TextView
                android:id="@+id/qAdjust"
                style="@style/QuickItem"
                android:contentDescription="Exposure and white balance"
                android:drawableTop="@drawable/ic_tune"
                android:text="Adjust" />
        </LinearLayout>

        <com.darshan.horizoncam.ui.ZoomBar
            android:id="@+id/zoomRow"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <LinearLayout
            android:id="@+id/modeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modePhoto"
                style="@style/ModeText"
                android:text="PHOTO" />

            <TextView
                android:id="@+id/modeVideo"
                style="@style/ModeText"
                android:text="VIDEO" />

            <TextView
                android:id="@+id/modeTimelapse"
                style="@style/ModeText"
                android:text="TIME-LAPSE" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="Open last capture"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_library" />

            <com.darshan.horizoncam.ui.ShutterButton
                android:id="@+id/shutter"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center" />

            <ImageButton
                android:id="@+id/btnSwitch"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="Switch camera"
                android:scaleType="center"
                android:src="@drawable/ic_cameraswitch"
                android:tint="@android:color/white" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_toast"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_needed"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnGrant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/grant" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
